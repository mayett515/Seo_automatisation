{
  "post-edit-lint": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/hooks/post-edit-lint-agy.mjs",
            "timeout": 90
          }
        ]
      }
    ]
  },
  "post-edit-checks": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/hooks/post-edit-checks-agy.mjs",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
