{
  "name": "@localseo/db",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "production": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./query": {
      "production": "./dist/query.js",
      "types": "./dist/query.d.ts",
      "default": "./src/query.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:check": "tsx scripts/check-migration-drift.ts"
  },
  "dependencies": {
    "@localseo/contracts": "workspace:*",
    "@localseo/domain": "workspace:*",
    "canonicalize": "3.0.0",
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.7"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10"
  }
}
