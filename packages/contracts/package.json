    },
    "./opportunity-research": {
      "production": "./dist/opportunity-research.js",
      "types": "./dist/opportunity-research.d.ts",
      "default": "./src/opportunity-research.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
