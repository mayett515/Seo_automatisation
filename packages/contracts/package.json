      "production": "./dist/common.js",
      "types": "./dist/common.d.ts",
      "default": "./src/common.ts"
    },
    "./identity": {
      "production": "./dist/identity.js",
      "types": "./dist/identity.d.ts",
      "default": "./src/identity.ts"
    },
    "./gsc": {
      "production": "./dist/gsc.js",
      "types": "./dist/gsc.d.ts",
      "default": "./src/gsc.ts"
    },
    "./website-import": {
      "production": "./dist/website-import.js",
      "types": "./dist/website-import.d.ts",
      "default": "./src/website-import.ts"
    },
    "./tracking": {
      "production": "./dist/tracking.js",
      "types": "./dist/tracking.d.ts",
      "default": "./src/tracking.ts"
    },
    "./jobs": {
      "production": "./dist/jobs.js",
      "types": "./dist/jobs.d.ts",
      "default": "./src/jobs.ts"
    },
    "./pages": {
      "production": "./dist/pages.js",
