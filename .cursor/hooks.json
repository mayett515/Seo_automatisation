{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "node .cursor/hooks/pre-tool-policy.mjs",
        "matcher": "Shell|Write|Delete",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "postToolUse": [
      {
        "command": "node .cursor/hooks/post-edit-lint.mjs",
        "matcher": "Write",
        "timeout": 90
      },
      {
        "command": "node .cursor/hooks/post-edit-lane-inventory.mjs",
        "matcher": "Write",
        "timeout": 90
      }
    ]
  }
}
