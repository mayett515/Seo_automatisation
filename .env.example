NODE_ENV=development
# Local scaffold auth allows demo-project and x-user-id helpers for local development only.
# Never enable it for production or real-data preview environments.
ALLOW_LOCAL_SCAFFOLD_AUTH=true
VITE_LOCAL_SCAFFOLD_AUTH=true
PORT=4000
WEB_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000
# Signs short-lived preview document/asset capabilities. Use an independent production secret.
PREVIEW_CAPABILITY_SECRET=replace-with-at-least-32-characters
# Use a hop count such as 1 behind one trusted production load balancer. Do not use true in production.
TRUST_PROXY=false
DATABASE_URL=postgres://postgres:postgres@localhost:5432/local_seo
# Disposable database for integration tests. The integration harness resets its public schema.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/local_seo_test
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_SECONDS=30
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_PING_TIMEOUT_MS=2000
REDIS_URL=redis://localhost:6379
AWS_REGION=eu-central-1
S3_BUCKET=local-seo-artifacts
LOCAL_OBJECT_STORAGE_DIR=.local-object-storage
# Media upload grants expire within ten minutes; bytes and quotas are checked before intent persistence.
MEDIA_UPLOAD_GRANT_TTL_SECONDS=600
MEDIA_MAX_UPLOAD_BYTES=10485760
MEDIA_MAX_UNRESOLVED_ASSETS=5
MEDIA_MAX_RETAINED_ASSETS=250
MEDIA_MAX_DERIVATIVE_BYTES=2147483648
# Bounded worker-owned cleanup for private media quarantine and failed derivative bytes.
MEDIA_CLEANUP_CLAIM_STALE_AFTER_MS=900000
MEDIA_CLEANUP_MAX_ATTEMPTS=3
MEDIA_CLEANUP_BATCH_SIZE=25
NETLIFY_AUTH_TOKEN=
AI_REASONING_PROVIDER=mock
# Checked-in example keeps GLM for page/content/frontend experiments.
# The first real opportunity-scout smoke should override this in an external env file:
# AI_REASONING_MODEL=deepseek-v4-flash
# Future search/SERP/competitor workers should use task-specific DeepSeek config.
AI_REASONING_MODEL=glm-5.2
AI_REASONING_OPENCODE_GO_API_KEY=
AI_REASONING_OPENCODE_GO_ENDPOINT=https://opencode.ai/zen/go/v1/chat/completions
AI_REASONING_TIMEOUT_MS=120000
# Purpose-named Opportunity Research runtime. Development defaults to the deterministic mock model.
OPPORTUNITY_RESEARCH_PROVIDER=mock
OPPORTUNITY_RESEARCH_MODEL=deepseek-v4-flash
OPPORTUNITY_RESEARCH_HEARTBEAT_MS=60000
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_MS=120000
DEEPSEEK_MAX_ATTEMPTS=2
DEEPSEEK_MAX_RESPONSE_BYTES=1000000
# Mastra checkpoints use their own schema and remain operational data, not product truth.
# Production must use a dedicated schema/database identity rather than the application-table owner shown for local dev.
MASTRA_WORKFLOW_DATABASE_URL=postgres://postgres:postgres@localhost:5432/local_seo
# DuckDuckGo discovery is research-support-only and never ranking proof.
PUBLIC_WEB_SEARCH_ENABLED=false
PUBLIC_WEB_SEARCH_TIMEOUT_MS=15000
PUBLIC_WEB_SEARCH_MAX_RESPONSE_BYTES=1000000
# Bounded DB-before-queue recovery for registered safe/idempotent lanes.
WORK_RECOVERY_STALE_AFTER_MS=900000
WORK_RECOVERY_MAX_COUNT=3
# Applied independently to each registered recovery lane and reused as the bounded Opportunity Research scheduler batch.
WORK_RECOVERY_BATCH_SIZE=25
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/gsc/callback
GSC_TOKEN_ENCRYPTION_KEY=replace-with-at-least-32-characters
GSC_OAUTH_STATE_SECRET=replace-with-at-least-32-characters
# Generate production secrets with a random source, for example: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-characters
BETTER_AUTH_URL=http://localhost:4000
